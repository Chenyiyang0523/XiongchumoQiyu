# Server only. Exact OpenAI-compatible /chat/completions URL; never bundle this key.
XCMQY_LLM_BACKEND=openai
# Local GLM: glm-local reads the existing Claude Code settings in memory and
# uses the GLM Coding JSON endpoint. No model token is copied to the client.
# XCMQY_LLM_BACKEND=glm-local
# XCMQY_LLM_MODEL=glm-5.3
# XCMQY_GLM_REASONING_EFFORT=low
# XCMQY_GLM_REPAIR_EFFORT=high
# XCMQY_GLM_CONCURRENCY=2
# Local GLM processes share OS request slots. Use one evaluator at a time.
# Alternative: claude-cli runs the local CLI without tools, hooks or MCP.
# XCMQY_CLAUDE_SETTINGS=/absolute/path/to/settings.json
# XCMQY_CLAUDE_BINARY=claude
XCMQY_LLM_ENDPOINT=https://your-provider.example/v1/chat/completions
XCMQY_LLM_MODEL=your-model
XCMQY_LLM_KEY=
XCMQY_GUARDIAN_CODE=replace-with-your-private-access-code
XCMQY_MODEL_TIMEOUT=240
XCMQY_BOOK_CALL_LIMIT=120
XCMQY_BOOK_TOKEN_LIMIT=700000
# Set both prices before enabling a positive dollar limit.
XCMQY_INPUT_USD_PER_MILLION=0
XCMQY_OUTPUT_USD_PER_MILLION=0
XCMQY_BOOK_USD_LIMIT=0
# Development only: explicitly selects fixtures. Never enabled as a model fallback.
XCMQY_DEVELOPMENT_MOCK=0
